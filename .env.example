# ── Pipedrive ────────────────────────────────────────────────────────────────
PIPEDRIVE_API_TOKEN=
# Opcionais: forçam funil/etapa do fluxo padrão (senão resolve por nome site/whats + entrada)
PIPEDRIVE_PIPELINE_NAME=
PIPEDRIVE_STAGE_NAME=
PIPEDRIVE_STAGE_ID=

# Segredo do webhook de negócio ganho (/api/pipedrive/webhook).
# Usar como senha do Basic auth (user "pipedrive") ao registrar o webhook no Pipedrive,
# ou como query ?secret= na URL. Gere um valor longo e aleatório.
PIPEDRIVE_WEBHOOK_SECRET=

# ── GA4 Measurement Protocol (receita de negócio ganho) ──────────────────────
# ID de medição do fluxo GA4 do container GTM-5NNPNZ (o código usa este valor
# como fallback se a env não estiver definida)
GA4_MEASUREMENT_ID=G-EY1FLE5C0J
# API secret criado em GA4 > Admin > Fluxos de dados > Measurement Protocol API secrets
GA4_API_SECRET=

# ── reCAPTCHA ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ── YouTube (seção Fator M) ──────────────────────────────────────────────────
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_HANDLE=
