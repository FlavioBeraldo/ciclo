    "tag": [
      {
        "tagId": "6300",
        "name": "PERFIL_A - Avaliar página autorizada",
        "type": "html",
        "parameter": [
          {
            "type": "TEMPLATE",
            "key": "html",
            "value": "<script>\n(function () {\n  'use strict';\n  // Contrato da CMP. Indisponível, revogado ou indefinido bloqueia o projeto.\n  function allowed() {\n    var p = typeof window.cicloPerfilPermissoes === 'function' && window.cicloPerfilPermissoes();\n    return !!(p && p.marketing === true && p.ad_storage === 'granted' &&\n      p.ad_user_data === 'granted' && p.ad_personalization === 'granted');\n  }\n  if (!allowed() || location.protocol !== 'https:') return;\n  var sessionKey = 'ciclo_pa_sessao_v1';\n  function cookie(name) {\n    var found = document.cookie.split(';').map(function (s) { return s.trim(); })\n      .filter(function (s) { return s.indexOf(name + '=') === 0; })[0];\n    return found ? found.slice(name.length + 1) : '';\n  }\n  function write(name, value) {\n    // Host atual, sem Domain. A landing canônica e a navegação usam o mesmo host.\n    document.cookie = name + '=' + value + '; Max-Age=7776000; Path=/; SameSite=Lax; Secure';\n  }\n  function record() {\n    if (!allowed()) return; // a revogação pode ocorrer enquanto outra aba mantém a trava\n    var q = new URLSearchParams(location.search);\n    var src = q.get('utm_source');\n    if (q.get('utm_term') === 'perfil_a' && /^(linkedin|meta|google)$/.test(src || '')) {\n      write('ciclo_perfil', 'A'); write('ciclo_perfil_origem', src);\n    }\n    src = cookie('ciclo_perfil_origem');\n    if (cookie('ciclo_perfil') !== 'A' || !/^(linkedin|meta|google)$/.test(src)) return;\n    var last = Number(localStorage.getItem(sessionKey) || 0), now = Date.now();\n    localStorage.setItem(sessionKey, String(now)); // renova a janela de inatividade em cada page view\n    if (last && now >= last && now - last < 1800000) return;\n    window.dataLayer = window.dataLayer || [];\n    window.dataLayer.push({event:'pa_visita_pronta', pa_perfil:'A', pa_origem:src,\n      pa_event_id:'pa-v-' + crypto.randomUUID()});\n  }\n  // Web Locks serializa duas abas. Sem armazenamento/trava, omite o sinal para evitar duplicatas.\n  if (navigator.locks && crypto.randomUUID) navigator.locks.request(sessionKey, record).catch(function () {});\n})();\n</script>\n"
          },
